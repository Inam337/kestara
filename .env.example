# Google Cloud OAuth2 client (Cloud Console → APIs & Services → Credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Obtained by running: npm run get-gmail-refresh-token
GMAIL_REFRESH_TOKEN=

# The Gmail account the OAuth client authorized against — the "From" address
GMAIL_SENDER_EMAIL=inam.337@gmail.com

# Where contact-form submissions are delivered (defaults to GMAIL_SENDER_EMAIL if unset)
CONTACT_TO_EMAIL=inam.337@gmail.com
